[Unit]
Description=Совкомбанк 850 · таймер утреннего сбора

[Timer]
# Время — ops/schedule.json (collect): строку OnCalendar вписывает
# `python ops/tools/schedule.py --write`, руками она не правится, равенство
# сверяет tests/test_ops_units.py. Ежедневно утром, после утренних тактов
# соседних панелей и через полчаса после соседнего банка семейства: сборщики
# форм четырёх панелей банков ходят на SOAP ЦБ с одного адреса, а на плотные
# серии запросов ЦБ отвечает отказом.
# Ранний такт нужен ради невосполнимых источников: даты и формы ЦБ по
# регномеру (винтаж — «что было известно на дату»), снимки T-Invest; они отдают
# ТЕКУЩЕЕ состояние, пропущенный день не добирается никогда. По понедельникам
# такт ещё и гоняет тесты такта «в будущем» (+60 дней).
OnCalendar=*-*-* 06:20:00 UTC
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=svcb850-collect.service

[Install]
WantedBy=timers.target
